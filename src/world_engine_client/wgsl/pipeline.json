{
  "pipeline": "wgsl/1",
  "comment": "D's pipeline (design doc 16 §9): splats and meshes. A module is the concatenation of its files, in order. Hosts load these files as they are; see README.md for bindings and dispatch order.",
  "modules": {
    "preprocess": ["common.wgsl", "preprocess.wgsl"],
    "sort": ["common.wgsl", "sort.wgsl"],
    "splat": ["common.wgsl", "splat.wgsl"],
    "mesh": ["common.wgsl", "cubeuv.wgsl", "material.wgsl", "mesh.wgsl"],
    "shadow": ["material.wgsl", "shadow.wgsl"],
    "pmrem": ["cubeuv.wgsl", "pmrem.wgsl"],
    "resolve": ["resolve.wgsl"]
  },
  "constants": {
    "WG": 256,
    "SORT_TILE": 1024,
    "RADIX": 256,
    "MAX_REC_CHUNKS": 16,
    "ST_WORDS": 200,
    "REC_BYTES": 32,
    "GEOM_VEC4_PER_SPLAT": 3,
    "VERTEX_BYTES": 80,
    "OWNER_BYTES": 128,
    "MATERIAL_SLOT": 512,
    "FRAME_BYTES": 256
  }
}
