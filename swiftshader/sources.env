# The sources world-engine-swiftshader is built from (design doc 16 §9.9). A new
# SwiftShader commit or SDK tag is a new minor version of the package.
SWIFTSHADER_REPO=https://swiftshader.googlesource.com/SwiftShader
SWIFTSHADER_MIRROR=https://github.com/google/swiftshader.git
SWIFTSHADER_COMMIT=cddb5c91b23ff70a1f607ea31610aa0d7f4b5ad5
VULKAN_SDK=vulkan-sdk-1.4.363.0
# The build images, pinned by digest (quay.io/pypa/manylinux_2_28_<arch>, both tagged
# 2026.10.26-1): another image can bring another compiler and other binaries, so a new
# image is a new version as well. build.sh records the image and its ID in build_info.json.
MANYLINUX_X86_64=quay.io/pypa/manylinux_2_28_x86_64@sha256:e0adf18521ad35192df733a6c62d35df7801957d24e0470238aacecfab2188a3
MANYLINUX_AARCH64=quay.io/pypa/manylinux_2_28_aarch64@sha256:a3e02308c822fb6ce0d12248b0c941817ba5e1a1bc9e7bb5929f29c50eaa40a9
